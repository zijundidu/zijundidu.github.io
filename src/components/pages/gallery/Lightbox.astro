---
// 相册灯箱：点击照片放大查看。
// 入口是 PhotoCard 上的 data-fancybox（组名）/ data-src（原图）标记；
// 事件委托绑定一次，Swup 切页、加密相册解锁后新出现的图片都能直接用。
// 零依赖，替代主题原本引用但未安装的 fancybox。
---

<lightbox-view
	id="gallery-lightbox"
	class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/92 backdrop-blur-sm select-none"
	role="dialog"
	aria-modal="true"
	aria-label="图片预览"
>
	<button data-lb-close class="absolute top-3 right-5 text-white/70 hover:text-white text-4xl leading-none px-2 py-1 transition-colors z-20" aria-label="关闭">×</button>
	<button data-lb-prev class="absolute left-2 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl px-3 py-2 transition-colors z-20" aria-label="上一张">‹</button>
	<img class="lb-photo max-h-[86vh] max-w-[92vw] object-contain rounded-lg shadow-2xl transition-transform duration-200" alt="照片预览" />
	<button data-lb-next class="absolute right-2 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl px-3 py-2 transition-colors z-20" aria-label="下一张">›</button>
	<div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white/70 text-sm tracking-wide" data-lb-counter></div>
</lightbox-view>

<script is:inline data-swup-ignore-script>
	(function initGalleryLightbox() {
		if (window.__galleryLightboxInit) return;
		window.__galleryLightboxInit = true;

		var boxEl = null;
		var imgEl = null;
		var counterEl = null;
		var items = [];
		var index = 0;
		var lastFocus = null;

		function resolveEls() {
			if (boxEl && document.documentElement.contains(boxEl)) return true;
			boxEl = document.getElementById("gallery-lightbox");
			if (!boxEl) return false;
			imgEl = boxEl.querySelector(".lb-photo");
			counterEl = boxEl.querySelector("[data-lb-counter]");
			boxEl.querySelector("[data-lb-close]").addEventListener("click", close);
			boxEl.querySelector("[data-lb-prev]").addEventListener("click", function (e) { e.stopPropagation(); show(index - 1); });
			boxEl.querySelector("[data-lb-next]").addEventListener("click", function (e) { e.stopPropagation(); show(index + 1); });
			// 点黑色背景关闭，点照片看下一张
			boxEl.addEventListener("click", function (e) {
				if (e.target === boxEl) close();
				else if (e.target === imgEl) show(index + 1);
			});
			return true;
		}

		function show(i) {
			if (!items.length) return;
			index = (i + items.length) % items.length;
			imgEl.style.opacity = "0";
			var preloaded = new Image();
			preloaded.onload = function () {
				imgEl.src = items[index];
				counterEl.textContent = (index + 1) + " / " + items.length;
				imgEl.style.opacity = "1";
			};
			preloaded.onerror = function () {
				imgEl.src = items[index];
				counterEl.textContent = (index + 1) + " / " + items.length;
				imgEl.style.opacity = "1";
			};
			preloaded.src = items[index];
			// 预取相邻两张，翻页不卡
			[1, -1].forEach(function (d) {
				var n = new Image();
				n.src = items[(index + d + items.length) % items.length];
			});
		}

		function open(group, src) {
			if (!resolveEls()) return;
			items = Array.prototype.slice
				.call(document.querySelectorAll('[data-fancybox="' + group + '"]'))
				.map(function (n) { return n.getAttribute("data-src"); })
				.filter(Boolean);
			if (!items.length) return;
			lastFocus = document.activeElement;
			boxEl.classList.remove("hidden");
			boxEl.classList.add("flex");
			document.body.style.overflow = "hidden";
			show(Math.max(0, items.indexOf(src)));
		}

		function close() {
			// 每次从文档里现找：Swup 切页可能替换过 DOM，存量的引用可能已脱离文档，
			// 对旧节点操作会让可见的灯箱盖着页面关不掉（"关闭后仍有覆盖"）
			var live = document.getElementById("gallery-lightbox") || boxEl;
			if (live) {
				live.classList.add("hidden");
				live.classList.remove("flex");
			}
			document.body.style.overflow = "";
			if (lastFocus && lastFocus.focus) lastFocus.focus();
		}

		document.addEventListener("click", function (e) {
			var el = e.target.closest && e.target.closest("[data-fancybox]");
			if (!el || !el.getAttribute("data-src")) return;
			e.preventDefault();
			open(el.getAttribute("data-fancybox"), el.getAttribute("data-src"));
		});

		document.addEventListener("keydown", function (e) {
			if (!boxEl || boxEl.classList.contains("hidden")) return;
			if (e.key === "Escape") close();
			else if (e.key === "ArrowLeft") show(index - 1);
			else if (e.key === "ArrowRight") show(index + 1);
		});
	})();
</script>

<style>
	lightbox-view:not(.hidden) {
		display: flex;
	}
	.lb-photo {
		opacity: 0;
	}
</style>
