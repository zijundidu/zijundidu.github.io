---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { getTotalComments } from "@/utils/comment-stats";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 访问量/访客数的统计锚点（带 ID 的 span）必须全页唯一（第三方 JS 按 ID 填充）。
// 桌面端实例渲染统计锚点（customProps.showBusuanzi），
// 移动端实例渲染复制展示位（customProps.showBusuanziCopy），由脚本同步数值
const { showBusuanzi, showBusuanziCopy } = (widgetConfig?.customProps ?? {}) as {
	showBusuanzi?: boolean;
	showBusuanziCopy?: boolean;
};

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";

// 获取所有文章
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数（口径与 Word/Typora 的“字数”接近：CJK 文字、全角标点、数字逐字符计数，
// 连续英文字母按 1 个单词计数；代码块、行内代码、链接/图片 URL、HTML 标签不计入）
let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		// 按行剔除围栏代码块：只有行首的 ``` 才算围栏开关，
		// 正文里演示 ``` 语法（如 "```mermaid 代码块"）不会被误吞
		let inFence = false;
		const keptLines: string[] = [];
		for (const line of post.body.split("\n")) {
			if (/^ {0,3}```/.test(line)) {
				inFence = !inFence;
				continue;
			}
			if (!inFence) keptLines.push(line);
		}
		const text = keptLines
			.join("\n")
			.replace(/`[^`\n]*`/g, " ") // 行内代码
			.replace(/!\[[^\]]*\]\([^)]*\)/g, " ") // 图片
			.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1") // 链接只保留锚文本
			.replace(/https?:\/\/\S+/g, " ") // 裸链接
			.replace(/<[^>\n]*>/g, " "); // HTML 标签

		const tokens =
			text.match(
				/[一-鿿㐀-䶿豈-﫿　-〿＀-￯]|[a-zA-Z]+|\d+/g,
			) || [];

		totalWords += tokens.length;
	}
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

// 获取「最后活动」时间：文章取 published 与 updated 中较新的那个，动态取 published，
// 再从全部内容里取最大值。这样新发文章/动态和修改老文章都会刷新该字段。
const getActivityDate = (post: (typeof posts)[number]): Date => {
	const { published, updated } = post.data;
	if (updated && updated > published) return updated;
	return published;
};

const dynamics = await getCollection("dynamic");

let lastActivityDate = posts.reduce<Date | null>((latest, post) => {
	const current = getActivityDate(post);
	if (!latest || current > latest) return current;
	return latest;
}, null);
for (const d of dynamics) {
	if (!lastActivityDate || d.data.published > lastActivityDate) {
		lastActivityDate = d.data.published;
	}
}

const lastPostDate = lastActivityDate ? lastActivityDate.toISOString() : null;

// 构建时从 GitHub Discussions 拉取全站评论总数（失败时降级为 0）
const totalComments = await getTotalComments();

const todayText = i18n(I18nKey.today);

const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length,
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length,
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length,
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		value: totalWords,
		formatted: true,
	},
	{
		icon: "material-symbols:calendar-clock-outline",
		label: i18n(I18nKey.siteStatsRunningDays),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDays).replace("{days}", ""),
		dynamic: true,
		id: "running-days",
	},
	{
		icon: "mingcute:heartbeat-line",
		label: i18n(I18nKey.siteStatsLastUpdate),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDaysAgo).replace("{days}", ""),
		dynamic: true,
		id: "last-update",
	},
];

// 下方三行：访问量/访客数由不蒜子在浏览器端填充，评论数为构建时数据
const statRowClass = "flex items-center justify-between px-3 py-1.5";
const statLabelClass =
	"flex items-center gap-2.5 text-neutral-700 dark:text-neutral-300 font-medium text-sm";
const statValueClass =
	"text-base font-bold text-neutral-900 dark:text-neutral-100";
const statSuffixClass = "ml-1 text-sm text-neutral-500 dark:text-neutral-400";
---

<WidgetLayout name={i18n(I18nKey.siteStats)} showTitle={showTitle} id="site-stats" class={className} style={style}>
  <div class="flex flex-col gap-2">
    {stats.map((stat) => (
      <div class="flex items-center justify-between px-3 py-1.5">
        <div class="flex items-center gap-2.5">
          <div class="text-(--primary) text-xl">
            <Icon name={stat.icon} />
          </div>
          <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            {stat.label}
          </span>
        </div>
        <div class="flex items-center">
          <span
            class="text-base font-bold text-neutral-900 dark:text-neutral-100"
            data-stat-id={stat.id}
          >
            {stat.formatted ? formatNumber(stat.value) : stat.value}
          </span>
          {stat.suffix && (
            <span class="ml-1 text-sm text-neutral-500 dark:text-neutral-400">
              {stat.suffix}
            </span>
          )}
        </div>
      </div>
    ))}
    {showBusuanzi && (
      <>
    <div class={statRowClass}>
      <div class={statLabelClass}>
        <div class="text-(--primary) text-xl">
          <Icon name="material-symbols:visibility-outline" />
        </div>
        <span>累计访问</span>
      </div>
      <div class="flex items-center">
        <span class={statValueClass} id="busuanzi_container_site_pv">
          <span id="busuanzi_value_site_pv">…</span>
        </span>
        <span class={statSuffixClass}>次</span>
      </div>
    </div>
    <div class={statRowClass}>
      <div class={statLabelClass}>
        <div class="text-(--primary) text-xl">
          <Icon name="material-symbols:group-outline" />
        </div>
        <span>访客数</span>
      </div>
      <div class="flex items-center">
        <span class={statValueClass} id="busuanzi_container_site_uv">
          <span id="busuanzi_value_site_uv">…</span>
        </span>
        <span class={statSuffixClass}>人</span>
      </div>
    </div>
      </>
    )}
    {showBusuanziCopy && (
      <>
    <div class={statRowClass}>
      <div class={statLabelClass}>
        <div class="text-(--primary) text-xl">
          <Icon name="material-symbols:visibility-outline" />
        </div>
        <span>累计访问</span>
      </div>
      <div class="flex items-center">
        <span class={statValueClass}><span class="js-site-pv">…</span></span>
        <span class={statSuffixClass}>次</span>
      </div>
    </div>
    <div class={statRowClass}>
      <div class={statLabelClass}>
        <div class="text-(--primary) text-xl">
          <Icon name="material-symbols:group-outline" />
        </div>
        <span>访客数</span>
      </div>
      <div class="flex items-center">
        <span class={statValueClass}><span class="js-site-uv">…</span></span>
        <span class={statSuffixClass}>人</span>
      </div>
    </div>
      </>
    )}
    <div class={statRowClass}>
      <div class={statLabelClass}>
        <div class="text-(--primary) text-xl">
          <Icon name="material-symbols:chat-bubble-outline" />
        </div>
        <span>累计评论</span>
      </div>
      <div class="flex items-center">
        <span class={statValueClass}>{formatNumber(totalComments)}</span>
        <span class={statSuffixClass}>条</span>
      </div>
    </div>
  </div>
</WidgetLayout>

<script is:inline define:vars={{ siteStartDate, lastPostDate, todayText }}>
  function updateDynamicStats() {
    const today = new Date();

    // 更新运行天数
    const startDate = new Date(siteStartDate);
    const diffTime = Math.abs(today.getTime() - startDate.getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    const runningDaysElements = document.querySelectorAll('[data-stat-id="running-days"]');
    runningDaysElements.forEach((element) => {
      element.textContent = diffDays.toString();
    });

    // 更新最后活动时间
    if (lastPostDate) {
      const lastPost = new Date(lastPostDate);
      const timeSinceLastPost = Math.abs(today.getTime() - lastPost.getTime());
      const daysSinceLastUpdate = Math.floor(timeSinceLastPost / (1000 * 60 * 60 * 24));

      const lastUpdateElements = document.querySelectorAll('[data-stat-id="last-update"]');
      lastUpdateElements.forEach((element) => {
        if (daysSinceLastUpdate === 0) {
          element.textContent = todayText;
          if (element.nextElementSibling) {
            element.nextElementSibling.style.display = 'none';
          }
        } else {
          element.textContent = daysSinceLastUpdate.toString();
          if (element.nextElementSibling) {
            element.nextElementSibling.style.display = '';
          }
        }
      });
    }
  }

  // 访问量统计同步：监听 Vercount 填充的锚点，把数值复制到全部展示位（含移动端），
  // 并用最近一次结果在无刷新跳转后回填，避免数字变回占位符
  function copyStatValues() {
    const pv = document.getElementById("busuanzi_value_site_pv")?.textContent?.trim();
    const uv = document.getElementById("busuanzi_value_site_uv")?.textContent?.trim();
    if (pv && pv !== "…") {
      window.__siteStatPv = pv;
      document.querySelectorAll(".js-site-pv").forEach((el) => { el.textContent = pv; });
    }
    if (uv && uv !== "…") {
      window.__siteStatUv = uv;
      document.querySelectorAll(".js-site-uv").forEach((el) => { el.textContent = uv; });
    }
  }

  function restoreStatValues() {
    if (window.__siteStatPv) {
      const pvEl = document.getElementById("busuanzi_value_site_pv");
      if (pvEl && (!pvEl.textContent || pvEl.textContent.trim() === "…")) pvEl.textContent = window.__siteStatPv;
      document.querySelectorAll(".js-site-pv").forEach((el) => { el.textContent = window.__siteStatPv; });
    }
    if (window.__siteStatUv) {
      const uvEl = document.getElementById("busuanzi_value_site_uv");
      if (uvEl && (!uvEl.textContent || uvEl.textContent.trim() === "…")) uvEl.textContent = window.__siteStatUv;
      document.querySelectorAll(".js-site-uv").forEach((el) => { el.textContent = window.__siteStatUv; });
    }
  }

  function bindStatObservers() {
    for (const id of ["busuanzi_value_site_pv", "busuanzi_value_site_uv"]) {
      const el = document.getElementById(id);
      if (el) {
        new MutationObserver(copyStatValues).observe(el, { childList: true, characterData: true, subtree: true });
      }
    }
  }

  // 页面加载时更新
  updateDynamicStats();
  copyStatValues();
  bindStatObservers();

  // 防止 Swup 切页重跑脚本时重复注册监听器
  if (!window.__siteStatsInit) {
    window.__siteStatsInit = true;
    // 页面切换时重新更新运行天数，并回填缓存的访问数据
    document.addEventListener("swup:contentReplaced", () => {
      setTimeout(() => {
        updateDynamicStats();
        restoreStatValues();
        bindStatObservers();
      }, 100);
    });
  }
</script>
