---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Kraken',
  description = 'Kraken 的个人主页，记录技术探索、生活瞬间和奇思妙想。',
  ogType = 'website',
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site).href;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Open Graph / Twitter -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content="Kraken 的个人主页">
  <meta name="twitter:card" content="summary">

  <!-- 主题切换必须在任何渲染之前执行，防止闪烁 -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('theme') || 'dark';
      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">
</head>
<body>
  <div id="progress-container">
    <div id="progress-bar"></div>
  </div>

  <nav>
    <div class="nav-links">
      <a href="/" class={currentPath === '/' ? 'active' : ''}>首页</a>
      <a href="/posts" class={currentPath.startsWith('/posts') ? 'active' : ''}>文章</a>
      <a href="/projects" class={currentPath.startsWith('/projects') ? 'active' : ''}>项目</a>
      <a href="/life" class={currentPath.startsWith('/life') ? 'active' : ''}>生活</a>
      <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>关于</a>
    </div>
    <div class="nav-right">
      <a href="/rss.xml" class="rss-link">RSS</a>
      <button class="theme-toggle" onclick="toggleTheme()">🌓</button>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <p>© 2026 Kraken. Built with Astro.</p>
    <p style="margin-top: 0.5rem;">
      <a href="/rss.xml">RSS 订阅</a>
    </p>
  </footer>

  <script>
    window.toggleTheme = () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    };

    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const progressBar = document.getElementById('progress-bar');
      if (progressBar) {
        progressBar.style.width = scrolled + "%";
      }
    });
  </script>
</body>
</html>
