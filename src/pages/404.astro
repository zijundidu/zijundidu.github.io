---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在 | Kraken" description="你要找的页面不存在或已被移动。">
  <div style="min-height: 50vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 3rem 0;">
    <h1 style="font-size: 5rem; font-weight: 800; color: var(--accent); margin-bottom: 1rem;">404</h1>
    <p style="color: var(--text-muted); font-size: 1.125rem; margin-bottom: 2rem;">
      你要找的页面不存在或已被移动。
    </p>
    <a href="/" style="color: var(--accent); text-decoration: none; font-size: 1rem;">← 返回首页</a>
  </div>
</BaseLayout>
