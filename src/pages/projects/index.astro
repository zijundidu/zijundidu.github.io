---
import { Icon } from "astro-icon/components";
import ProjectCard from "@/components/pages/projects/ProjectCard.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import { getSortedProjects } from "@/utils/content-utils";
import {
	getProjectStatusMeta,
	PROJECT_STATUS_KEYS,
} from "@/utils/projects-utils";
import { getFileDirFromPath, removeFileExtension } from "@/utils/url-utils";
import "@/styles/pages/card-grid.css";

// 检查页面是否启用
if (!siteConfig.pages.projects) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.projects);
const description = i18n(I18nKey.projectsDescription);

const projects = await getSortedProjects();
const projectMeta = projects.map((p) => ({
	id: removeFileExtension(p.id),
	title: p.data.title,
	description: p.data.description,
	image: p.data.image,
	basePath: getFileDirFromPath(p.filePath || ""),
	tags: p.data.tags,
	published: p.data.published,
	link: p.data.link,
	status: p.data.status,
}));

// 筛选：显示全部已知状态（带图标）
const statusFilters = PROJECT_STATUS_KEYS.map((key) => {
	const meta = getProjectStatusMeta(key);
	return { key, label: meta.label, icon: meta.icon };
});

// ── 构建时自动从 GitHub API 拉取仓库列表（失败时降级为空，不影响构建）──
const GITHUB_USERNAME = "zijundidu";

interface GithubRepo {
	name: string;
	html_url: string;
	description: string | null;
	language: string | null;
	stargazers_count: number;
	updated_at: string;
	fork: boolean;
	archived: boolean;
}

let githubRepos: GithubRepo[] = [];
let githubFailed = false;

try {
	const res = await fetch(
		`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=12`,
	);
	if (!res.ok) throw new Error(`GitHub API 返回 ${res.status}`);
	const data: unknown = await res.json();
	if (Array.isArray(data)) {
		githubRepos = (data as GithubRepo[])
			.filter((repo) => !repo.fork && !repo.archived)
			.slice(0, 9);
	}
} catch (error) {
	console.error("拉取 GitHub 仓库失败：", error);
	githubFailed = true;
}

const langColors: Record<string, string> = {
	JavaScript: "#f1e05a",
	TypeScript: "#3178c6",
	Python: "#3572A5",
	Java: "#b07219",
	Go: "#00ADD8",
	Rust: "#dea584",
	HTML: "#e34c26",
	CSS: "#563d7c",
	Vue: "#41b883",
	React: "#61dafb",
	Astro: "#ff5d01",
	Shell: "#89e051",
	"C++": "#f34b7d",
	C: "#555555",
};

function formatUpdatedAt(dateStr: string): string {
	const diff = Date.now() - new Date(dateStr).getTime();
	const days = Math.floor(diff / (1000 * 60 * 60 * 24));
	if (days <= 0) return "今天";
	if (days === 1) return "昨天";
	if (days < 7) return `${days} 天前`;
	if (days < 30) return `${Math.floor(days / 7)} 周前`;
	return new Date(dateStr).toLocaleDateString("zh-CN");
}
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell">
		<!-- 标题面板 -->
		<header class="card-base page-header">
			<div class="page-heading">
				<div class="page-icon" aria-hidden="true">
					<Icon name="material-symbols:rocket-launch" />
				</div>
				<div>
					<h2>{title}</h2>
					{description && <p>{description}</p>}
				</div>
			</div>
			<div class="page-count" aria-label={title}>
				<Icon name="material-symbols:rocket-launch" />
				<strong>{projectMeta.length}</strong>
				<span>{title}</span>
			</div>
		<!-- 搜索 + 状态筛选（标题面板内，整行；搜索与筛选分两行） -->
		<project-filter style="grid-column: 1 / -1">
			<div class="relative mb-3">
				<Icon
					name="material-symbols:search"
					class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
				/>
				<input
					type="text"
					data-search
					placeholder={i18n(I18nKey.projectSearch)}
					class="w-full pl-10 pr-4 py-2 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
				/>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<button
					data-status="all"
					class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200"
					data-active
				>
					{i18n(I18nKey.all)}
				</button>
				{statusFilters.map((s) => (
					<button
						data-status={s.key}
						class="category-pill px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200 inline-flex items-center gap-1.5"
					>
						{s.icon && <Icon name={s.icon} class="text-base" />}
						{s.label}
					</button>
				))}
			</div>
		</project-filter>
		</header>

		<!-- 内容面板：项目卡片网格 -->
		{projectMeta.length > 0 ? (
			<div class="card-grid" style="--card-grid-min-width: 320px">
				{projectMeta.map((p) => (
					<ProjectCard
						id={p.id}
						title={p.title}
						description={p.description}
						image={p.image}
						basePath={p.basePath}
						tags={p.tags}
						published={p.published}
						link={p.link}
						status={p.status}
					/>
				))}
			</div>
		) : (
			<div class="card-base flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
				<Icon name="material-symbols:rocket-launch" class="text-6xl mb-4 opacity-50" />
				<p class="text-lg">{i18n(I18nKey.projectEmpty)}</p>
			</div>
		)}

		<!-- 筛选无结果空态 -->
		<div class="projects-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
			<Icon name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
			<div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
		</div>

		<!-- GitHub 仓库：构建时自动同步（不参与上方筛选） -->
		<header class="card-base page-header mt-6">
			<div class="page-heading">
				<div class="page-icon" aria-hidden="true">
					<Icon name="fa7-brands:github" />
				</div>
				<div>
					<h2>GitHub 仓库</h2>
					<p>构建时自动同步，最近更新的非 Fork 仓库</p>
				</div>
			</div>
		</header>
		{githubFailed && (
			<div class="card-base px-6 py-4 text-sm text-neutral-500 dark:text-neutral-400">
				GitHub 数据暂时拉取失败，
				<a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener noreferrer" class="link text-(--primary) font-medium">直接访问我的 GitHub</a>
			</div>
		)}
		{githubRepos.length > 0 && (
			<div class="card-grid" style="--card-grid-min-width: 280px">
				{githubRepos.map((repo) => (
					<a
						href={repo.html_url}
						target="_blank"
						rel="noopener noreferrer"
						class="github-repo-card card-base p-5 flex flex-col gap-2 transition-colors hover:border-(--primary)"
					>
						<div class="flex items-center justify-between gap-2">
							<span class="font-semibold text-(--primary) truncate">{repo.name}</span>
							<span class="text-xs text-neutral-500 dark:text-neutral-400 shrink-0">⭐ {repo.stargazers_count}</span>
						</div>
						<p class="text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2 min-h-10">
							{repo.description || "暂无描述"}
						</p>
						<div class="flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400 mt-auto">
							{repo.language && (
								<span class="inline-flex items-center gap-1">
									<span class="w-2 h-2 rounded-full" style={`background-color: ${langColors[repo.language] || "#8b949e"}`}></span>
									{repo.language}
								</span>
							)}
							<span>更新于 {formatUpdatedAt(repo.updated_at)}</span>
						</div>
					</a>
				))}
			</div>
		)}
	</section>

	<script slot="head" is:inline>
		if (!customElements.get("project-filter")) {
			class ProjectFilter extends HTMLElement {
				selectedStatus = "all";
				connectedCallback() {
					this.addEventListener("click", this.handleClick);
					this.addEventListener("input", this.handleInput);
				}
				disconnectedCallback() {
					this.removeEventListener("click", this.handleClick);
					this.removeEventListener("input", this.handleInput);
				}
				handleClick(e) {
					const button = e.target.closest("button");
					if (!button) return;
					this.selectedStatus = button.dataset.status;
					this.querySelectorAll("button").forEach((b) =>
						b.removeAttribute("data-active"),
					);
					button.setAttribute("data-active", "");
					this.applyFilters();
				}
				handleInput() {
					this.applyFilters();
				}
				applyFilters() {
					const container = this.closest(".page-shell");
					if (!container) return;
					const input = this.querySelector("[data-search]");
					const query = (input?.value || "").toLowerCase().trim();
					const cards = container.querySelectorAll(".project-card");
					let hasVisible = false;
					cards.forEach((card) => {
						const statusMatch =
							this.selectedStatus === "all" ||
							card.dataset.status === this.selectedStatus;
						const tags = (card.dataset.tags || "").toLowerCase();
						const title = (
							card.querySelector(".post-card-title")?.textContent || ""
						).toLowerCase();
						const desc = (
							card.querySelector(".description")?.textContent || ""
						).toLowerCase();
						const searchMatch =
							!query ||
							title.includes(query) ||
							desc.includes(query) ||
							tags.includes(query);
						if (statusMatch && searchMatch) {
							card.style.display = "";
							hasVisible = true;
						} else {
							card.style.display = "none";
						}
					});
					const empty = container.querySelector(".projects-empty");
					if (empty) {
						empty.classList.toggle("hidden", hasVisible);
						empty.classList.toggle("flex", !hasVisible);
					}
				}
			}
			customElements.define("project-filter", ProjectFilter);
		}
	</script>

</MainGridLayout>
