---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { publishedOnly } from '../../lib/content';
import Giscus from '../../components/Giscus.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';

export async function getStaticPaths() {
  const items = publishedOnly(await getCollection('life'));
  return items.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.data.title,
  description: item.data.description,
  datePublished: item.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: 'Kraken' },
  url: Astro.url.href,
};
---

<BaseLayout title={`${item.data.title} | Kraken`} description={item.data.description} ogType="article">
  <article style="padding: 3rem 0; max-width: 900px;">
    <header style="margin-bottom: 2rem;">
      {item.data.cover && (
        <img
          src={item.data.cover}
          alt={item.data.title}
          style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 12px; margin-bottom: 2rem;"
        />
      )}

      <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem;">
        {item.data.title}
      </h1>

      <div style="color: var(--text-faint); font-size: 0.9rem;">
        <time>{item.data.pubDate.toLocaleDateString('zh-CN')}</time>
        {item.data.location && <span> · 📍 {item.data.location}</span>}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border);">
      <a href="/life" style="color: var(--accent); text-decoration: none;">← 返回生活记录</a>
    </footer>

    <Giscus />
  </article>

  <ImageLightbox />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
